    setp.eq.u32 %p, %t32, 0;
    setp.ne.u32 %q, %be, 0;
    and.pred %p, %p, %q;
    @%p mov.u32 %i, %target;
    @%p mov.u32 %be, 0;
    bra BB_NEXT;

BB_NEXT:
    add.u32 %i, %i, 1;
    bra BB_LOOP;

BB_FINAL:
    /* feed-forward: r0 += k0, r1 += k1, r6 += k2, r7 += k3 */
    add.u64 %ad, %lmem, 0;
    ld.local.u64 %d, [%ad];
    add.u64 %d, %d, %k0;
    st.local.u64 [%ad], %d;
    add.u64 %ad, %lmem, 8;
    ld.local.u64 %d, [%ad];
    add.u64 %d, %d, %k1;
    st.local.u64 [%ad], %d;
    add.u64 %ad, %lmem, 48;
    ld.local.u64 %d, [%ad];
    add.u64 %d, %d, %k2;
    st.local.u64 [%ad], %d;
    add.u64 %ad, %lmem, 56;
    ld.local.u64 %d, [%ad];
    add.u64 %d, %d, %k3;
    st.local.u64 [%ad], %d;

    add.u64 %ad, %lmem, 0;
    ld.local.u64 %v0, [%ad];
    add.u64 %ad, %lmem, 8;
    ld.local.u64 %v1, [%ad];
    add.u64 %ad, %lmem, 16;
    ld.local.u64 %v2, [%ad];
    add.u64 %ad, %lmem, 24;
    ld.local.u64 %v3, [%ad];
    add.u64 %v0, %v0, %v1;
    add.u64 %v2, %v2, %v3;
    shl.b64 %ta, %v1, 13;
    shr.u64 %tb, %v1, 51;
    or.b64 %v1, %ta, %tb;
    shl.b64 %ta, %v3, 16;
    shr.u64 %tb, %v3, 48;
    or.b64 %v3, %ta, %tb;
    xor.b64 %v1, %v1, %v0;
    xor.b64 %v3, %v3, %v2;
    shl.b64 %ta, %v0, 32;
    shr.u64 %tb, %v0, 32;
    or.b64 %v0, %ta, %tb;
    add.u64 %v2, %v2, %v1;
    add.u64 %v0, %v0, %v3;
    shl.b64 %ta, %v1, 17;
    shr.u64 %tb, %v1, 47;
    or.b64 %v1, %ta, %tb;
    shl.b64 %ta, %v3, 21;
    shr.u64 %tb, %v3, 43;
    or.b64 %v3, %ta, %tb;
    xor.b64 %v1, %v1, %v2;
    xor.b64 %v3, %v3, %v0;
    shl.b64 %ta, %v2, 32;
    shr.u64 %tb, %v2, 32;
    or.b64 %v2, %ta, %tb;
    add.u64 %ad, %lmem, 0;
    st.local.u64 [%ad], %v0;
    add.u64 %ad, %lmem, 8;
    st.local.u64 [%ad], %v1;
    add.u64 %ad, %lmem, 16;
    st.local.u64 [%ad], %v2;
    add.u64 %ad, %lmem, 24;
    st.local.u64 [%ad], %v3;
    add.u64 %ad, %lmem, 32;
    ld.local.u64 %v0, [%ad];
    add.u64 %ad, %lmem, 40;
    ld.local.u64 %v1, [%ad];
    add.u64 %ad, %lmem, 48;
    ld.local.u64 %v2, [%ad];
    add.u64 %ad, %lmem, 56;
    ld.local.u64 %v3, [%ad];
    add.u64 %v0, %v0, %v1;
    add.u64 %v2, %v2, %v3;
    shl.b64 %ta, %v1, 13;
    shr.u64 %tb, %v1, 51;
    or.b64 %v1, %ta, %tb;
    shl.b64 %ta, %v3, 16;
    shr.u64 %tb, %v3, 48;
    or.b64 %v3, %ta, %tb;
    xor.b64 %v1, %v1, %v0;
    xor.b64 %v3, %v3, %v2;
    shl.b64 %ta, %v0, 32;
    shr.u64 %tb, %v0, 32;
    or.b64 %v0, %ta, %tb;
    add.u64 %v2, %v2, %v1;
    add.u64 %v0, %v0, %v3;
    shl.b64 %ta, %v1, 17;
    shr.u64 %tb, %v1, 47;
    or.b64 %v1, %ta, %tb;
    shl.b64 %ta, %v3, 21;
    shr.u64 %tb, %v3, 43;
    or.b64 %v3, %ta, %tb;
    xor.b64 %v1, %v1, %v2;
    xor.b64 %v3, %v3, %v0;
    shl.b64 %ta, %v2, 32;
    shr.u64 %tb, %v2, 32;
    or.b64 %v2, %ta, %tb;
    add.u64 %ad, %lmem, 32;
    st.local.u64 [%ad], %v0;
    add.u64 %ad, %lmem, 40;
    st.local.u64 [%ad], %v1;
    add.u64 %ad, %lmem, 48;
    st.local.u64 [%ad], %v2;
    add.u64 %ad, %lmem, 56;
    st.local.u64 [%ad], %v3;
    add.u64 %ad, %lmem, 0;
    ld.local.u64 %x, [%ad];
    add.u64 %ad, %lmem, 32;
    ld.local.u64 %y, [%ad];
    xor.b64 %w0, %x, %y;
    add.u64 %ad, %lmem, 8;
    ld.local.u64 %x, [%ad];
    add.u64 %ad, %lmem, 40;
    ld.local.u64 %y, [%ad];
    xor.b64 %w1, %x, %y;
    add.u64 %ad, %lmem, 16;
    ld.local.u64 %x, [%ad];
    add.u64 %ad, %lmem, 48;
    ld.local.u64 %y, [%ad];
    xor.b64 %w2, %x, %y;
    add.u64 %ad, %lmem, 24;
    ld.local.u64 %x, [%ad];
    add.u64 %ad, %lmem, 56;
    ld.local.u64 %y, [%ad];
    xor.b64 %w3, %x, %y;

    /* digest words, big-endian, so the hit test is a shift on hw[] */
    mov.u64 %x, %w0;
    cvt.u32.u64 %wlo, %x;
    and.b32 %b0, %wlo, 0x000000ff;
    shl.b32 %b0, %b0, 24;
    and.b32 %b1, %wlo, 0x0000ff00;
    shl.b32 %b1, %b1, 8;
    and.b32 %b2, %wlo, 0x00ff0000;
    shr.b32 %b2, %b2, 8;
    and.b32 %b3, %wlo, 0xff000000;
    shr.b32 %b3, %b3, 24;
    or.b32 %b0, %b0, %b1;
    or.b32 %b2, %b2, %b3;
    or.b32 %b0, %b0, %b2;
    add.u64 %ad, %lmem, 64;
    st.local.u32 [%ad], %b0;
    shr.u64 %x, %w0, 32;
    cvt.u32.u64 %wlo, %x;
    and.b32 %b0, %wlo, 0x000000ff;
    shl.b32 %b0, %b0, 24;
    and.b32 %b1, %wlo, 0x0000ff00;
    shl.b32 %b1, %b1, 8;
    and.b32 %b2, %wlo, 0x00ff0000;
    shr.b32 %b2, %b2, 8;
    and.b32 %b3, %wlo, 0xff000000;
    shr.b32 %b3, %b3, 24;
    or.b32 %b0, %b0, %b1;
    or.b32 %b2, %b2, %b3;
    or.b32 %b0, %b0, %b2;
    add.u64 %ad, %lmem, 68;
    st.local.u32 [%ad], %b0;
    mov.u64 %x, %w1;
    cvt.u32.u64 %wlo, %x;
    and.b32 %b0, %wlo, 0x000000ff;
    shl.b32 %b0, %b0, 24;
    and.b32 %b1, %wlo, 0x0000ff00;
    shl.b32 %b1, %b1, 8;
    and.b32 %b2, %wlo, 0x00ff0000;
    shr.b32 %b2, %b2, 8;
    and.b32 %b3, %wlo, 0xff000000;
    shr.b32 %b3, %b3, 24;
    or.b32 %b0, %b0, %b1;
    or.b32 %b2, %b2, %b3;
    or.b32 %b0, %b0, %b2;
    add.u64 %ad, %lmem, 72;
    st.local.u32 [%ad], %b0;
    shr.u64 %x, %w1, 32;
    cvt.u32.u64 %wlo, %x;
    and.b32 %b0, %wlo, 0x000000ff;
    shl.b32 %b0, %b0, 24;
    and.b32 %b1, %wlo, 0x0000ff00;
    shl.b32 %b1, %b1, 8;
    and.b32 %b2, %wlo, 0x00ff0000;
    shr.b32 %b2, %b2, 8;
    and.b32 %b3, %wlo, 0xff000000;
    shr.b32 %b3, %b3, 24;
    or.b32 %b0, %b0, %b1;
    or.b32 %b2, %b2, %b3;
    or.b32 %b0, %b0, %b2;
    add.u64 %ad, %lmem, 76;
    st.local.u32 [%ad], %b0;
    mov.u64 %x, %w2;
    cvt.u32.u64 %wlo, %x;
    and.b32 %b0, %wlo, 0x000000ff;
    shl.b32 %b0, %b0, 24;
    and.b32 %b1, %wlo, 0x0000ff00;
    shl.b32 %b1, %b1, 8;
    and.b32 %b2, %wlo, 0x00ff0000;
    shr.b32 %b2, %b2, 8;
    and.b32 %b3, %wlo, 0xff000000;
    shr.b32 %b3, %b3, 24;
    or.b32 %b0, %b0, %b1;
    or.b32 %b2, %b2, %b3;
    or.b32 %b0, %b0, %b2;
    add.u64 %ad, %lmem, 80;
    st.local.u32 [%ad], %b0;
    shr.u64 %x, %w2, 32;
    cvt.u32.u64 %wlo, %x;
    and.b32 %b0, %wlo, 0x000000ff;
    shl.b32 %b0, %b0, 24;
    and.b32 %b1, %wlo, 0x0000ff00;
    shl.b32 %b1, %b1, 8;
    and.b32 %b2, %wlo, 0x00ff0000;
    shr.b32 %b2, %b2, 8;
    and.b32 %b3, %wlo, 0xff000000;
    shr.b32 %b3, %b3, 24;
    or.b32 %b0, %b0, %b1;
    or.b32 %b2, %b2, %b3;
    or.b32 %b0, %b0, %b2;
    add.u64 %ad, %lmem, 84;
    st.local.u32 [%ad], %b0;
    mov.u64 %x, %w3;
    cvt.u32.u64 %wlo, %x;
    and.b32 %b0, %wlo, 0x000000ff;
    shl.b32 %b0, %b0, 24;
    and.b32 %b1, %wlo, 0x0000ff00;
    shl.b32 %b1, %b1, 8;
    and.b32 %b2, %wlo, 0x00ff0000;
    shr.b32 %b2, %b2, 8;
    and.b32 %b3, %wlo, 0xff000000;
    shr.b32 %b3, %b3, 24;
    or.b32 %b0, %b0, %b1;
    or.b32 %b2, %b2, %b3;
    or.b32 %b0, %b0, %b2;
    add.u64 %ad, %lmem, 88;
    st.local.u32 [%ad], %b0;
    shr.u64 %x, %w3, 32;
    cvt.u32.u64 %wlo, %x;
    and.b32 %b0, %wlo, 0x000000ff;
    shl.b32 %b0, %b0, 24;
    and.b32 %b1, %wlo, 0x0000ff00;
    shl.b32 %b1, %b1, 8;
    and.b32 %b2, %wlo, 0x00ff0000;
    shr.b32 %b2, %b2, 8;
    and.b32 %b3, %wlo, 0xff000000;
    shr.b32 %b3, %b3, 24;
    or.b32 %b0, %b0, %b1;
    or.b32 %b2, %b2, %b3;
    or.b32 %b0, %b0, %b2;
    add.u64 %ad, %lmem, 92;
    st.local.u32 [%ad], %b0;

    /* difficulty: leading zero bits, MSB first */
    mov.u32 %b, 0;
BB_BIT:
    setp.ge.u32 %p, %b, %difficulty;
    @%p bra BB_HIT;
    shr.b32 %t32, %b, 5;
    mul.wide.u32 %off, %t32, 4;
    add.u64 %ad, %lmem, %off;
    ld.local.u32 %tmpw, [%ad+64];
    and.b32 %t32, %b, 31;
    sub.u32 %shift, 31, %t32;
    shr.u32 %tmpw, %tmpw, %shift;
    and.b32 %tmpw, %tmpw, 1;
    setp.ne.u32 %p, %tmpw, 0;
    @%p bra BB_DONE;
    add.u32 %b, %b, 1;
    bra BB_BIT;

BB_HIT:
    atom.global.add.u32 %slot, [%res], 1;
    setp.lt.u32 %p, %slot, 8;
    @!%p bra BB_DONE;
    mul.wide.u32 %off, %slot, 4;
    add.u64 %ad, %res, %off;
    st.global.u32 [%ad+16], %nonce;
    mul.wide.u32 %off, %slot, 32;
    add.u64 %ad, %res, %off;
    add.u64 %ad, %ad, 48;
    ld.local.u32 %tmpw, [%lmem+64];
    st.global.u32 [%ad], %tmpw;
    mul.wide.u32 %off, %slot, 32;
    add.u64 %ad, %res, %off;
    add.u64 %ad, %ad, 52;
    ld.local.u32 %tmpw, [%lmem+68];
    st.global.u32 [%ad], %tmpw;
    mul.wide.u32 %off, %slot, 32;
    add.u64 %ad, %res, %off;
    add.u64 %ad, %ad, 56;
    ld.local.u32 %tmpw, [%lmem+72];
    st.global.u32 [%ad], %tmpw;
    mul.wide.u32 %off, %slot, 32;
    add.u64 %ad, %res, %off;
    add.u64 %ad, %ad, 60;
    ld.local.u32 %tmpw, [%lmem+76];
    st.global.u32 [%ad], %tmpw;
    mul.wide.u32 %off, %slot, 32;
    add.u64 %ad, %res, %off;
    add.u64 %ad, %ad, 64;
    ld.local.u32 %tmpw, [%lmem+80];
    st.global.u32 [%ad], %tmpw;
    mul.wide.u32 %off, %slot, 32;
    add.u64 %ad, %res, %off;
    add.u64 %ad, %ad, 68;
    ld.local.u32 %tmpw, [%lmem+84];
    st.global.u32 [%ad], %tmpw;
    mul.wide.u32 %off, %slot, 32;
    add.u64 %ad, %res, %off;
    add.u64 %ad, %ad, 72;
    ld.local.u32 %tmpw, [%lmem+88];
    st.global.u32 [%ad], %tmpw;
    mul.wide.u32 %off, %slot, 32;
    add.u64 %ad, %res, %off;
    add.u64 %ad, %ad, 76;
    ld.local.u32 %tmpw, [%lmem+92];
    st.global.u32 [%ad], %tmpw;

BB_DONE:
    ret;
}
